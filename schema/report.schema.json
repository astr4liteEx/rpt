{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/astr4liteEx/rpt/schema/report.schema.json",
  "title": "rpt report record",
  "description": "The whole render-ready document emitted by rpt assemble, as one record on one line.",
  "type": "object",
  "properties": {
    "kind": {"const": "report"},
    "schema_version": {"type": "integer", "minimum": 1},
    "report": {"$ref": "#/$defs/reportMeta"},
    "summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}, "description": "Finding count per severity level."},
    "scope": {"type": "array", "items": {"$ref": "scope.schema.json"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/reportFinding"}, "description": "Sorted by the config's severity order, then by ID."}
  },
  "required": ["kind", "schema_version", "report", "summary", "scope", "findings"],
  "additionalProperties": true,
  "$defs": {
    "reportMeta": {
      "type": "object",
      "properties": {
        "severities": {"type": "array", "items": {"type": "string"}, "description": "The report's severity levels, most severe first."},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/reportSection"}, "description": "The report's sections in the order rpt writes them: the fixed ones with this report's headings, then the custom ones it requires, as rpt sections gives them."}
      },
      "required": ["severities", "sections"],
      "additionalProperties": true
    },
    "reportSection": {
      "type": "object",
      "properties": {
        "key": {"type": "string", "description": "The key a finding's sections use: description, remediation, poc, or a custom section's heading."},
        "heading": {"type": "string", "description": "The heading this report gives the section, for a reader."}
      },
      "required": ["key", "heading"],
      "additionalProperties": true
    },
    "reportFinding": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "severity": {"type": "string"},
        "targets": {"type": "array", "items": {"$ref": "#/$defs/reportTarget"}, "description": "The finding's targets, each with its full scope row in place of the scope ID."},
        "sections": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Markdown per section."},
        "assets": {"type": "array", "items": {"type": "string"}, "description": "Absolute paths of evidence files."}
      },
      "required": ["id", "title", "severity", "targets", "sections", "assets"],
      "additionalProperties": true
    },
    "reportTarget": {
      "type": "object",
      "description": "A finding target with its scope row in full; host, port and protocol as in finding.schema.json#/$defs/target.",
      "properties": {
        "scope": {"$ref": "scope.schema.json"},
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "protocol": {"enum": ["tcp", "udp"]}
      },
      "required": ["scope"],
      "additionalProperties": true
    }
  }
}
