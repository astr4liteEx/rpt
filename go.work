// The workspace builds rpt against the SDK in ./sdk. The replace lets
// go.mod require an sdk/vX.Y.Z that isn't published yet; its version must
// be the one go.mod requires. Outside the workspace (go install
// …@version) rpt uses the published SDK, so a release tags both: see
// scripts/release.sh.
go 1.27.0

toolchain go1.27.4

use (
	.
	./sdk
)

replace github.com/astr4liteEx/rpt/sdk v0.2.1 => ./sdk
